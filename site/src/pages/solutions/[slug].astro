---
import Layout from '../../layouts/Layout.astro';
import PainPoint from '../../components/PainPoint.astro';
import CaseStudyCard from '../../components/CaseStudyCard.astro';
import TechStack from '../../components/TechStack.astro';
import FAQSection from '../../components/FAQSection.astro';
import CTABanner from '../../components/CTABanner.astro';
import services from '../../data/services.json';

export function getStaticPaths() {
  return services.solutions.map((solution) => ({
    params: { slug: solution.slug },
    props: { solution }
  }));
}

const { solution } = Astro.props;
const { iconPaths, caseStudies } = services;

// Get related case studies
const relatedCaseStudies = caseStudies.filter(cs =>
  solution.relatedCaseStudies.includes(cs.id)
);

// Schema.org Service + FAQPage
const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: solution.title,
  description: solution.subheadline,
  url: `https://dvorson.github.io/solutions/${solution.slug}`,
  provider: {
    '@type': 'Person',
    name: 'Anton Dvorson',
    url: 'https://dvorson.github.io'
  },
  areaServed: ['Netherlands', 'Europe'],
  serviceType: solution.title
};
---

<Layout
  title={solution.seoTitle}
  description={solution.seoDescription}
  ogImage={`/og/solutions-${solution.slug}.png`}
  url={`https://dvorson.github.io/solutions/${solution.slug}`}
  canonical={`https://dvorson.github.io/solutions/${solution.slug}`}
  additionalSchema={[serviceSchema]}
>
  <!-- 1. Hero -->
  <section class="border-b border-rule">
    <div class="container" style="padding-top: 96px; padding-bottom: 96px;">
      <span class="font-mono text-xs tracking-widest uppercase text-accent mb-4 block">{solution.shortTitle}</span>
      <h1 class="font-display text-3xl sm:text-4xl lg:text-5xl font-bold leading-tight tracking-tight mb-6" style="max-width: 800px;">
        {solution.headline}
      </h1>
      <p class="text-xl text-muted leading-relaxed mb-10" style="max-width: 640px;">
        {solution.subheadline}
      </p>
      <div class="flex flex-col sm:flex-row gap-4">
        <a href="https://linkedin.com/in/dvorson" target="_blank" rel="noopener noreferrer" class="btn-primary">
          Let's Discuss Your Challenge
        </a>
        <a href="#approach" class="btn-secondary">
          See How It Works
        </a>
      </div>
    </div>
  </section>

  <!-- 2. The Problem — Pain points -->
  <section class="border-b border-rule">
    <div class="container" style="padding-top: 96px; padding-bottom: 96px;">
      <div class="section-header">
        <div>
          <span class="section-number">01</span>
          <h2 class="section-title mt-2">Sound familiar?</h2>
        </div>
      </div>
      <p class="text-muted mb-10">If any of these hit close to home, you're not alone. This is where most {solution.persona.toLowerCase().includes('cto') ? 'technical leaders' : 'leaders'} get stuck.</p>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        {solution.painPoints.map((pain, i) => (
          <PainPoint text={pain} index={i + 1} />
        ))}
      </div>
    </div>
  </section>

  <!-- 3. What is [X]? — Definition block -->
  <section class="border-b border-rule">
    <div class="container" style="padding-top: 96px; padding-bottom: 96px;">
      <div class="border-l-2 border-accent pl-8">
        <span class="font-mono text-xs tracking-widest uppercase text-muted mb-3 block">Definition</span>
        <h2 class="font-display text-xl font-bold mb-4">What is {solution.shortTitle}?</h2>
        <p class="text-muted leading-relaxed">{solution.definition}</p>
      </div>
    </div>
  </section>

  <!-- 4. The Approach -->
  <section id="approach" class="border-b border-rule">
    <div class="container" style="padding-top: 96px; padding-bottom: 96px;">
      <div class="section-header">
        <div>
          <span class="section-number">02</span>
          <h2 class="section-title mt-2">How we work together</h2>
        </div>
      </div>
      <p class="text-muted mb-10">A structured process that reduces risk and gives you visibility at every step.</p>

      <div class="grid grid-cols-1 md:grid-cols-2 border border-rule">
        {solution.approach.map((step, i) => (
          <div class={`p-8 ${i % 2 === 0 ? 'md:border-r border-rule' : ''} ${i < solution.approach.length - 2 ? 'border-b border-rule' : i < solution.approach.length - 1 ? 'border-b md:border-b-0 border-rule' : ''}`}>
            <span class="font-mono text-xs text-muted tracking-wider">0{i + 1}</span>
            <h3 class="font-display text-lg font-bold mt-3 mb-2">{step.step}</h3>
            <p class="text-sm text-muted leading-relaxed">{step.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 5. Outcomes -->
  <section class="border-b border-rule">
    <div class="container" style="padding-top: 96px; padding-bottom: 96px;">
      <div class="section-header">
        <div>
          <span class="section-number">03</span>
          <h2 class="section-title mt-2">What you get</h2>
        </div>
      </div>
      <p class="text-muted mb-10">Concrete deliverables, not vague promises.</p>

      <div class="space-y-4">
        {solution.outcomes.map((outcome, i) => (
          <div class="flex items-start gap-4 py-4 border-b border-rule last:border-b-0">
            <span class="font-mono text-xs text-muted mt-0.5">{String(i + 1).padStart(2, '0')}</span>
            <p class="leading-relaxed">{outcome}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 6. Case Study Snapshot -->
  {relatedCaseStudies.length > 0 && (
    <section class="border-b border-rule">
      <div class="container" style="padding-top: 96px; padding-bottom: 96px;">
        <div class="section-header">
          <div>
            <span class="section-number">04</span>
            <h2 class="section-title mt-2">Proof it works</h2>
          </div>
          <a href="/case-studies" class="font-mono text-xs tracking-wider uppercase text-muted hover:text-ink transition-colors">All case studies →</a>
        </div>
        <p class="text-muted mb-10">Real projects where this approach delivered results.</p>

        <div class={`grid grid-cols-1 ${relatedCaseStudies.length > 1 ? 'md:grid-cols-2' : 'max-w-lg'} gap-6`}>
          {relatedCaseStudies.map((cs) => (
            <CaseStudyCard caseStudy={{
              slug: cs.slug,
              title: cs.title,
              domain: cs.domain,
              client: cs.client,
              outcomes: cs.outcomes,
              technologies: cs.technologies,
              icon: cs.icon,
              iconPath: iconPaths[cs.icon],
              hasFullPage: cs.hasFullPage
            }} />
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- 7. Technologies -->
  <section class="border-b border-rule">
    <div class="container" style="padding-top: 96px; padding-bottom: 96px;">
      <div class="section-header">
        <div>
          <span class="section-number">{relatedCaseStudies.length > 0 ? '05' : '04'}</span>
          <h2 class="section-title mt-2">Technologies I work with</h2>
        </div>
      </div>
      <TechStack technologies={solution.technologies} />
    </div>
  </section>

  <!-- 8. Pricing indicator -->
  <section class="border-b border-rule">
    <div class="container" style="padding-top: 96px; padding-bottom: 96px;">
      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 border border-rule p-8">
        <div>
          <span class="font-mono text-xs tracking-widest uppercase text-muted mb-2 block">Investment</span>
          <h2 class="font-display text-xl font-bold mb-1">Typical investment</h2>
          <p class="text-sm text-muted">Depends on scope, timeline, and complexity. Let's discuss your specific situation.</p>
        </div>
        <div class="text-right">
          <p class="font-display text-2xl font-bold text-accent">{solution.pricing.range}</p>
          <p class="font-mono text-xs text-muted">{solution.pricing.unit}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 9. FAQ -->
  <section class="border-b border-rule">
    <div class="container" style="padding-top: 96px; padding-bottom: 96px;">
      <div class="section-header">
        <div>
          <span class="section-number">{relatedCaseStudies.length > 0 ? '06' : '05'}</span>
          <h2 class="section-title mt-2">Common questions</h2>
        </div>
      </div>
      <FAQSection faqs={solution.faqs} />
    </div>
  </section>

  <!-- 10. Final CTA -->
  <CTABanner
    headline={`Ready to ${solution.shortTitle === 'AI Strategy' ? 'set your AI direction' : solution.shortTitle === 'GraphRAG' ? 'fix your knowledge base' : solution.shortTitle === 'AI E-commerce' ? 'transform your storefront' : solution.shortTitle === 'LLM Integration' ? 'ship AI features' : 'ship your AI project'}?`}
    description="Let's have a 30-minute conversation about your challenge. No pitch, no pressure — just an honest assessment of whether this is the right approach for you."
    ctaText="Let's Talk on LinkedIn"
  />

  <!-- Back to solutions -->
  <div class="container py-8">
    <a href="/solutions" class="font-mono text-xs tracking-wider uppercase text-muted hover:text-ink transition-colors inline-flex items-center">
      <svg class="w-4 h-4 mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M7 16l-4-4m0 0l4-4m-4 4h18" />
      </svg>
      Back to all solutions
    </a>
  </div>
</Layout>
