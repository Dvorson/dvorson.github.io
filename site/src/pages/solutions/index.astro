---
import Layout from '../../layouts/Layout.astro';
import SolutionCard from '../../components/SolutionCard.astro';
import CTABanner from '../../components/CTABanner.astro';
import services from '../../data/services.json';

const { solutions, iconPaths } = services;

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'AI Solutions by Anton Dvorson',
  description: 'AI consulting solutions: agents, knowledge graphs, e-commerce architecture, strategy, and LLM integration.',
  numberOfItems: solutions.length,
  itemListElement: solutions.map((s, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    item: {
      '@type': 'Service',
      name: s.title,
      description: s.subheadline,
      url: `https://dvorson.github.io/solutions/${s.slug}`
    }
  }))
};
---

<Layout
  title="AI Solutions | Anton Dvorson — AI Solutions Architect"
  description="AI consulting solutions: production-ready agents, GraphRAG knowledge graphs, AI-powered e-commerce, fractional technical leadership, and LLM integration."
  ogImage="/og/solutions.png"
  url="https://dvorson.github.io/solutions"
  canonical="https://dvorson.github.io/solutions"
  additionalSchema={[serviceSchema]}
>
  <section class="border-b border-rule">
    <div class="container" style="padding-top: 96px; padding-bottom: 96px;">
      <div class="section-header">
        <div>
          <span class="section-number">01</span>
          <h1 class="section-title mt-2">Every AI challenge is different</h1>
        </div>
      </div>
      <p class="text-muted leading-relaxed mb-0" style="max-width: 640px;">Here's where I can help. Each engagement starts with your problem, not a generic playbook. Pick the challenge that sounds most like yours.</p>
    </div>
  </section>

  <section class="border-b border-rule">
    <div class="container" style="padding-top: 96px; padding-bottom: 96px;">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 border border-rule">
        {solutions.map((solution, i) => (
          <a href={`/solutions/${solution.slug}`}
             class={`block p-8 hover:bg-muted-light transition-colors ${
               i % 3 !== 2 ? 'lg:border-r lg:border-rule' : ''
             } ${i % 2 !== 1 ? 'md:border-r md:border-rule lg:border-r-0' : 'md:border-r-0'} ${
               i < solutions.length - 3 ? 'lg:border-b lg:border-rule' : ''
             } ${i < solutions.length - 2 ? 'md:border-b md:border-rule lg:border-b-0' : 'md:border-b-0'} border-b border-rule last:border-b-0 md:last:border-b-0`}
          >
            <span class="font-mono text-xs text-muted tracking-wider">0{i + 1}</span>
            <h3 class="font-display text-xl font-bold mt-3 mb-2">{solution.shortTitle}</h3>
            <p class="text-sm text-muted leading-relaxed">{solution.subheadline.split(' — ')[0].substring(0, 120)}{solution.subheadline.length > 120 ? '...' : ''}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Value props -->
  <section class="border-b border-rule">
    <div class="container" style="padding-top: 96px; padding-bottom: 96px;">
      <div class="section-header">
        <div>
          <span class="section-number">02</span>
          <h2 class="section-title mt-2">Why work with me</h2>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 border border-rule">
        <div class="p-8 border-b md:border-b-0 md:border-r border-rule">
          <span class="font-mono text-xs text-muted tracking-wider uppercase">Depth</span>
          <h3 class="font-display text-lg font-bold mt-3 mb-2">Strategy to code</h3>
          <p class="text-sm text-muted leading-relaxed">From architecture decisions to production-ready code — no hand-off to juniors.</p>
        </div>
        <div class="p-8 border-b md:border-b-0 md:border-r border-rule">
          <span class="font-mono text-xs text-muted tracking-wider uppercase">Scale</span>
          <h3 class="font-display text-lg font-bold mt-3 mb-2">Enterprise battle-tested</h3>
          <p class="text-sm text-muted leading-relaxed">12+ years across Fortune-500 retail, telecom, and media. I've seen what breaks at scale.</p>
        </div>
        <div class="p-8">
          <span class="font-mono text-xs text-muted tracking-wider uppercase">Flexibility</span>
          <h3 class="font-display text-lg font-bold mt-3 mb-2">Your way</h3>
          <p class="text-sm text-muted leading-relaxed">Solo delivery or embedded in your team — you choose how we work together.</p>
        </div>
      </div>
    </div>
  </section>

  <CTABanner
    headline="Not sure where to start?"
    description="Let's have a 30-minute conversation about your challenge. I'll give you an honest assessment — even if the answer is 'you don't need AI for this.'"
    ctaText="Let's Talk on LinkedIn"
  />
</Layout>
