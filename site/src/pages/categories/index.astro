---
import Layout from '../../layouts/Layout.astro';
import PostList from '../../components/PostList.astro';
import { getPosts } from '../../lib/posts';

const posts = await getPosts();
const categories = [...new Set(posts.flatMap((post) => post.data.categories))].sort();
---

<Layout title="Categories | Anton Dvorson">
  <section class="container py-16" style="max-width: 900px;">
    <a href="/blog" class="font-mono text-xs text-muted hover:text-ink transition-colors">← All posts</a>
    <h1 class="section-title mt-8 mb-8">Categories</h1>
    <div class="space-y-12">
      {categories.map((category) => (
        <div>
          <h2 class="font-display text-xl font-bold mb-2">
            <a href={`/categories/${encodeURIComponent(category)}/`} class="hover:text-accent transition-colors">{category}</a>
          </h2>
          <PostList posts={posts.filter((post) => post.data.categories.includes(category))} />
        </div>
      ))}
    </div>
  </section>
</Layout>
