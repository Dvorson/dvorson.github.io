---
import Layout from '../../layouts/Layout.astro';
import CTABanner from '../../components/CTABanner.astro';
import { services, type CaseStudy } from '../../lib/data';

const { caseStudies } = services;
const groups: { number: string; title: string; items: CaseStudy[] }[] = [
  { number: '02', title: 'AI & Agentic Systems', items: caseStudies.filter((cs) => cs.featured && cs.domain !== 'E-commerce') },
  { number: '03', title: 'Platforms & E-commerce', items: caseStudies.filter((cs) => cs.domain === 'E-commerce') },
  { number: '04', title: 'Other work', items: caseStudies.filter((cs) => !cs.featured) },
].filter((group) => group.items.length > 0);
---

<Layout
  title="Case Studies | Anton Dvorson"
  description="Knowledge graphs, multi-agent systems, an SEC-filings research platform, and a multi-brand headless storefront: problem, approach, outcome, and stack for each."
  ogImage="/og/case-studies.png"
>
  <section class="border-b border-rule">
    <div class="container" style="padding-top: 96px; padding-bottom: 96px;">
      <div class="section-header">
        <div>
          <span class="section-number">01</span>
          <h1 class="section-title mt-2">Case studies</h1>
        </div>
      </div>
      <p class="text-muted leading-relaxed" style="max-width: 640px;">Selected projects: the problem, what I built, and what came out of it. Client names are withheld under NDA.</p>
    </div>
  </section>

  {groups.map((group) => (
    <section class="border-b border-rule">
      <div class="container" style="padding-top: 96px; padding-bottom: 96px;">
        <div class="section-header">
          <div>
            <span class="section-number">{group.number}</span>
            <h2 class="section-title mt-2">{group.title}</h2>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-px bg-rule border border-rule">
          {group.items.map((cs) => (
            <a href={`/case-studies/${cs.slug}`} class="block bg-surface p-8 hover:bg-muted-light transition-colors">
              <span class="font-mono text-xs tracking-widest uppercase text-accent">{cs.domain}</span>
              <h3 class="font-display text-lg font-bold mt-3 mb-2">{cs.title}</h3>
              <p class="text-sm text-muted leading-relaxed mb-4">{cs.client} · {cs.role}</p>
              <div class="flex flex-wrap gap-2">
                {cs.technologies.slice(0, 4).map((tech) => (
                  <span class="font-mono text-xs border border-rule px-3 py-1 text-muted">{tech}</span>
                ))}
              </div>
              <p class="text-sm text-muted mt-4 pt-4 border-t border-rule">{cs.outcomes[0]}</p>
            </a>
          ))}
        </div>
      </div>
    </section>
  ))}

  <div class="container">
    <CTABanner />
  </div>
</Layout>
