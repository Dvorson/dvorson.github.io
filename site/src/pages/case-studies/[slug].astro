---
import Layout from '../../layouts/Layout.astro';
import TechStack from '../../components/TechStack.astro';
import CTABanner from '../../components/CTABanner.astro';
import services from '../../data/services.json';

export function getStaticPaths() {
  return services.caseStudies
    .filter(cs => cs.hasFullPage)
    .map((cs) => ({
      params: { slug: cs.slug },
      props: { caseStudy: cs }
    }));
}

const { caseStudy } = Astro.props;
const { iconPaths, solutions } = services;

// Find related solutions
const relatedSolutions = solutions.filter(s =>
  s.relatedCaseStudies.includes(caseStudy.id)
);
---

<Layout
  title={`${caseStudy.title} | Case Study — Anton Dvorson`}
  description={`Case study: ${caseStudy.challenge.slice(0, 150)}...`}
  ogImage={`/og/cs-${caseStudy.slug}.png`}
  url={`https://dvorson.github.io/case-studies/${caseStudy.slug}`}
  canonical={`https://dvorson.github.io/case-studies/${caseStudy.slug}`}
>
  <!-- Header -->
  <section class="border-b border-rule">
    <div class="container" style="padding-top: 96px; padding-bottom: 96px;">
      <a href="/case-studies" class="font-mono text-xs tracking-wider uppercase text-muted hover:text-ink transition-colors inline-flex items-center mb-8">
        <svg class="w-4 h-4 mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M7 16l-4-4m0 0l4-4m-4 4h18" />
        </svg>
        All case studies
      </a>

      <div class="flex items-center gap-4 mb-6">
        <span class="font-mono text-xs border border-accent text-accent px-3 py-1">{caseStudy.domain}</span>
        <span class="font-mono text-xs text-muted">{caseStudy.duration}</span>
      </div>

      <h1 class="font-display text-3xl sm:text-4xl font-bold tracking-tight mb-4">
        {caseStudy.title}
      </h1>
      <div class="flex flex-wrap items-center gap-6 font-mono text-xs text-muted">
        <span><strong class="text-ink">Client:</strong> {caseStudy.client}</span>
        <span><strong class="text-ink">Role:</strong> {caseStudy.role}</span>
      </div>
    </div>
  </section>

  <!-- The Challenge -->
  <section class="border-b border-rule">
    <div class="container" style="padding-top: 96px; padding-bottom: 96px;">
      <div class="section-header">
        <div>
          <span class="section-number">01</span>
          <h2 class="section-title mt-2">The Challenge</h2>
        </div>
      </div>
      <div class="border-l-2 border-accent pl-8">
        <p class="text-muted leading-relaxed">{caseStudy.challenge}</p>
      </div>
    </div>
  </section>

  <!-- The Approach -->
  <section class="border-b border-rule">
    <div class="container" style="padding-top: 96px; padding-bottom: 96px;">
      <div class="section-header">
        <div>
          <span class="section-number">02</span>
          <h2 class="section-title mt-2">The Approach</h2>
        </div>
      </div>
      <p class="leading-relaxed" style="max-width: 720px;">{caseStudy.approach}</p>
    </div>
  </section>

  <!-- The Outcome -->
  <section class="border-b border-rule">
    <div class="container" style="padding-top: 96px; padding-bottom: 96px;">
      <div class="section-header">
        <div>
          <span class="section-number">03</span>
          <h2 class="section-title mt-2">The Outcome</h2>
        </div>
      </div>

      <div class="space-y-0">
        {caseStudy.outcomes.map((outcome, i) => (
          <div class="flex items-start gap-4 py-4 border-b border-rule last:border-b-0">
            <span class="font-mono text-xs text-muted mt-0.5">{String(i + 1).padStart(2, '0')}</span>
            <p class="leading-relaxed">{outcome}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Technologies -->
  <section class="border-b border-rule">
    <div class="container" style="padding-top: 96px; padding-bottom: 96px;">
      <div class="section-header">
        <div>
          <span class="section-number">04</span>
          <h2 class="section-title mt-2">Technologies</h2>
        </div>
      </div>
      <TechStack technologies={caseStudy.technologies} />
    </div>
  </section>

  <!-- Related Solutions -->
  {relatedSolutions.length > 0 && (
    <section class="border-b border-rule">
      <div class="container" style="padding-top: 96px; padding-bottom: 96px;">
        <div class="section-header">
          <div>
            <span class="section-number">05</span>
            <h2 class="section-title mt-2">Related solutions</h2>
          </div>
          <a href="/solutions" class="font-mono text-xs tracking-wider uppercase text-muted hover:text-ink transition-colors">All solutions →</a>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 border border-rule">
          {relatedSolutions.map((s, i) => (
            <a href={`/solutions/${s.slug}`} class={`block p-8 hover:bg-muted-light transition-colors ${i < relatedSolutions.length - 1 ? 'border-b md:border-b-0 md:border-r border-rule' : ''}`}>
              <span class="font-mono text-xs tracking-widest uppercase text-accent">{s.shortTitle}</span>
              <h3 class="font-display text-lg font-bold mt-3 mb-2">{s.title}</h3>
              <p class="text-sm text-muted leading-relaxed">{s.subheadline.slice(0, 120)}...</p>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- CTA -->
  <CTABanner
    headline="Facing a similar challenge?"
    description="Let's talk about how I can help your team get the same kind of results. 30 minutes, no pitch — just an honest conversation about your situation."
    ctaText="Let's Talk on LinkedIn"
  />
</Layout>
