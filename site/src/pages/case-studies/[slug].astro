---
import Layout from '../../layouts/Layout.astro';
import TechStack from '../../components/TechStack.astro';
import CTABanner from '../../components/CTABanner.astro';
import { getEntry, render } from 'astro:content';
import { services, type CaseStudy } from '../../lib/data';

export function getStaticPaths() {
  return services.caseStudies
    .filter((cs) => cs.hasFullPage)
    .map((cs) => ({
      params: { slug: cs.slug },
      props: { caseStudy: cs },
    }));
}

const { caseStudy } = Astro.props as { caseStudy: CaseStudy };
const writeup = await getEntry('caseStudyWriteups', caseStudy.slug);
const Writeup = writeup ? (await render(writeup)).Content : null;
---

<Layout
  title={`${caseStudy.title} | Case Study | Anton Dvorson`}
  description={caseStudy.challenge.length > 155 ? `${caseStudy.challenge.slice(0, 152).trimEnd()}...` : caseStudy.challenge}
  ogImage={`/og/cs-${caseStudy.slug}.png`}
>
  <!-- Header -->
  <section class="border-b border-rule">
    <div class="container" style="padding-top: 96px; padding-bottom: 96px;">
      <a href="/case-studies" class="font-mono text-xs tracking-wider uppercase text-muted hover:text-ink transition-colors inline-flex items-center mb-8">
        <svg class="w-4 h-4 mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M7 16l-4-4m0 0l4-4m-4 4h18" />
        </svg>
        All case studies
      </a>

      <div class="flex items-center gap-4 mb-6">
        <span class="font-mono text-xs border border-accent text-accent px-3 py-1">{caseStudy.domain}</span>
        <span class="font-mono text-xs text-muted">{caseStudy.duration}</span>
      </div>

      <h1 class="font-display text-3xl sm:text-4xl font-bold tracking-tight mb-4">
        {caseStudy.title}
      </h1>
      <div class="flex flex-wrap items-center gap-6 font-mono text-xs text-muted">
        <span><strong class="text-ink">Client:</strong> {caseStudy.client}</span>
        <span><strong class="text-ink">Role:</strong> {caseStudy.role}</span>
      </div>
    </div>
  </section>

  <!-- The Challenge -->
  <section class="border-b border-rule">
    <div class="container" style="padding-top: 96px; padding-bottom: 96px;">
      <div class="section-header">
        <div>
          <span class="section-number">01</span>
          <h2 class="section-title mt-2">The Challenge</h2>
        </div>
      </div>
      <div class="border-l-2 border-accent pl-8">
        <p class="text-muted leading-relaxed">{caseStudy.challenge}</p>
      </div>
    </div>
  </section>

  <!-- The Approach, or the full write-up when one exists -->
  {Writeup ? (
    <section class="border-b border-rule">
      <div class="container" style="padding-top: 96px; padding-bottom: 96px;">
        <div class="section-header">
          <div>
            <span class="section-number">02</span>
            <h2 class="section-title mt-2">How it was built</h2>
          </div>
        </div>
        <div class="prose" style="max-width: 760px;">
          <Writeup />
        </div>
      </div>
    </section>
  ) : (
    <section class="border-b border-rule">
      <div class="container" style="padding-top: 96px; padding-bottom: 96px;">
        <div class="section-header">
          <div>
            <span class="section-number">02</span>
            <h2 class="section-title mt-2">The Approach</h2>
          </div>
        </div>
        <p class="leading-relaxed" style="max-width: 720px;">{caseStudy.approach}</p>
      </div>
    </section>
  )}

  <!-- The Outcome -->
  <section class="border-b border-rule">
    <div class="container" style="padding-top: 96px; padding-bottom: 96px;">
      <div class="section-header">
        <div>
          <span class="section-number">03</span>
          <h2 class="section-title mt-2">The Outcome</h2>
        </div>
      </div>

      <div class="space-y-0">
        {caseStudy.outcomes.map((outcome, i) => (
          <div class="flex items-start gap-4 py-4 border-b border-rule last:border-b-0">
            <span class="font-mono text-xs text-muted mt-0.5">{String(i + 1).padStart(2, '0')}</span>
            <p class="leading-relaxed">{outcome}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Technologies -->
  <section class="border-b border-rule">
    <div class="container" style="padding-top: 96px; padding-bottom: 96px;">
      <div class="section-header">
        <div>
          <span class="section-number">04</span>
          <h2 class="section-title mt-2">Technologies</h2>
        </div>
      </div>
      <TechStack technologies={caseStudy.technologies} />
    </div>
  </section>

  {caseStudy.screenshot && (
    <section class="border-b border-rule">
      <div class="container" style="padding-top: 96px; padding-bottom: 96px;">
        <figure>
          <img src={caseStudy.screenshot} alt={`Screenshot: ${caseStudy.title}`} class="w-full border border-rule" loading="lazy" />
          {caseStudy.screenshotCaption && (
            <figcaption class="font-mono text-xs text-muted mt-3">{caseStudy.screenshotCaption}</figcaption>
          )}
        </figure>
      </div>
    </section>
  )}

  <div class="container">
    <CTABanner />
  </div>
</Layout>
