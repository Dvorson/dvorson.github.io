---
import Layout from '../layouts/Layout.astro';
import FAQSection from '../components/FAQSection.astro';
import CTABanner from '../components/CTABanner.astro';
import services from '../data/services.json';

const { pricing } = services;

const pricingFaqs = [
  { question: "What's included in the initial discovery call?", answer: "A 30-minute conversation where I listen to your challenge, ask questions about your current situation, and give you an honest assessment of whether I can help. No sales pitch, no obligation. If there's a fit, I'll follow up with a concrete proposal." },
  { question: "How do you handle payment?", answer: "Invoiced monthly or by milestone, depending on the engagement type. I'm based in the Netherlands and invoice in EUR. Payment terms are Net 30." },
  { question: "Can I start with Advisory and then move to Implementation?", answer: "Absolutely — that's a common path. Many clients start with an Advisory engagement to validate the approach, then move to Implementation once they have clarity and confidence." },
  { question: "What if the project scope changes mid-engagement?", answer: "It happens. I handle scope changes transparently: we discuss the impact on timeline and budget, agree on the adjusted scope in writing, and move forward. No surprise invoices." },
  { question: "Do you work with agencies or only direct clients?", answer: "Both. I regularly work through agencies as well as directly with end clients. The engagement model adapts to your procurement process." }
];
---

<Layout
  title="Pricing | Transparent AI Consulting Rates — Anton Dvorson"
  description="No surprises. Transparent pricing for AI consulting: advisory engagements from EUR 2,500, implementation projects from EUR 15,000, fractional embedded from EUR 8,000/month."
  ogImage="/og/pricing.png"
  url="https://dvorson.github.io/pricing"
  canonical="https://dvorson.github.io/pricing"
>
  <!-- Hero -->
  <section class="container py-16">
    <div class="section-header">
      <div>
        <span class="section-number">Pricing</span>
        <h1 class="section-title mt-2">No surprises. Here's how I work and what it costs.</h1>
      </div>
    </div>
    <p class="text-muted leading-relaxed max-w-2xl">Transparent pricing, clear scope, fixed deliverables. You know exactly what you're getting before we start.</p>
  </section>

  <!-- How I Work -->
  <section class="container mb-20">
    <div class="flex items-baseline gap-4 mb-8">
      <span class="section-number">01</span>
      <h2 class="section-title">How every engagement works</h2>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-px bg-rule border border-rule">
      {pricing.processSteps.map((step, i) => (
        <div class="bg-surface p-6">
          <span class="font-mono text-xs text-muted">{String(i + 1).padStart(2, '0')}</span>
          <h3 class="font-display text-lg font-bold mt-2 mb-2">{step.name}</h3>
          <p class="text-sm text-muted leading-relaxed">{step.description}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Pricing Tiers -->
  <section class="container mb-20">
    <div class="flex items-baseline gap-4 mb-8">
      <span class="section-number">02</span>
      <h2 class="section-title">Engagement models</h2>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-px bg-rule border border-rule">
      {pricing.tiers.map((tier, i) => (
        <div class={`bg-surface p-8 flex flex-col ${i === 1 ? 'border-t-2 border-t-accent' : ''}`}>
          {i === 1 && (
            <span class="font-mono text-xs text-accent uppercase tracking-wider mb-4">Most common</span>
          )}
          <h3 class="font-display text-xl font-bold mb-1">{tier.name}</h3>
          <p class="text-sm text-muted mb-4">{tier.tagline}</p>

          <div class="mb-4">
            <p class="font-mono text-2xl font-bold text-ink">{tier.range}</p>
            <p class="font-mono text-xs text-muted">{tier.unit}</p>
          </div>

          <p class="font-mono text-xs text-muted mb-4">{tier.duration}</p>

          <p class="text-sm text-muted mb-6 leading-relaxed">{tier.description}</p>

          <div class="border-t border-rule pt-4 mt-auto">
            <p class="font-mono text-xs text-muted uppercase tracking-wider mb-3">Includes</p>
            <ul class="space-y-2">
              {tier.includes.map((item) => (
                <li class="flex items-start gap-2 text-sm text-ink">
                  <span class="text-muted mt-0.5 flex-shrink-0">—</span>
                  {item}
                </li>
              ))}
            </ul>
          </div>
        </div>
      ))}
    </div>
    <p class="font-mono text-xs text-muted text-center mt-6">{pricing.note}</p>
  </section>

  <!-- FAQ -->
  <section class="container mb-20">
    <div class="flex items-baseline gap-4 mb-8">
      <span class="section-number">03</span>
      <h2 class="section-title">Common questions</h2>
    </div>
    <FAQSection faqs={pricingFaqs} />
  </section>

  <!-- CTA -->
  <div class="container">
    <CTABanner
      headline="Let's talk about your project"
      description="30 minutes, no obligation. I'll listen to your challenge and give you an honest assessment of how I can help — and what it'll cost."
      ctaText="Let's Talk on LinkedIn"
    />
  </div>
</Layout>
