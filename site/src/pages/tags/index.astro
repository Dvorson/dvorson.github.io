---
import Layout from '../../layouts/Layout.astro';
import { getPosts } from '../../lib/posts';

const posts = await getPosts();
const counts = new Map<string, number>();
for (const tag of posts.flatMap((post) => post.data.tags)) {
  counts.set(tag, (counts.get(tag) ?? 0) + 1);
}
const tags = [...counts.keys()].sort((a, b) => a.localeCompare(b));
---

<Layout title="Tags | Anton Dvorson">
  <section class="container py-16" style="max-width: 900px;">
    <a href="/blog" class="font-mono text-xs text-muted hover:text-ink transition-colors">← All posts</a>
    <h1 class="section-title mt-8 mb-8">Tags</h1>
    <div class="flex flex-wrap gap-2">
      {tags.map((tag) => (
        <a href={`/tags/${encodeURIComponent(tag)}/`} class="font-mono text-xs border border-rule px-3 py-1 text-muted hover:text-ink hover:border-ink transition-colors">
          {tag} <span class="opacity-60">{counts.get(tag)}</span>
        </a>
      ))}
    </div>
  </section>
</Layout>
