---
import Layout from '../../layouts/Layout.astro';
import PostList from '../../components/PostList.astro';
import { getPosts } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPosts();
  const tags = [...new Set(posts.flatMap((post) => post.data.tags))].sort();
  return tags.map((tag) => ({
    params: { tag },
    props: { posts: posts.filter((post) => post.data.tags.includes(tag)) },
  }));
}

const { tag } = Astro.params;
const { posts } = Astro.props;
---

<Layout title={`Posts tagged "${tag}" | Anton Dvorson`}>
  <section class="container py-16" style="max-width: 900px;">
    <a href="/tags/" class="font-mono text-xs text-muted hover:text-ink transition-colors">← All tags</a>
    <h1 class="section-title mt-8 mb-6">Posts tagged "{tag}"</h1>
    <PostList posts={posts} />
  </section>
</Layout>
