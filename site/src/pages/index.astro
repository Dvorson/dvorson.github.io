---
import Layout from '../layouts/Layout.astro';
import ContactForm from '../components/ContactForm.astro';
import services from '../data/services.json';

const postModules = import.meta.glob('../posts/*.md', { eager: true });
const posts = Object.entries(postModules)
  .map(([path, post]) => {
    const slug = path.split('/').pop()?.replace('.md', '') || '';
    return {
      ...post.frontmatter,
      url: `/${slug}`,
      date: post.frontmatter.date || post.frontmatter.pubDate,
      title: post.frontmatter.title
    };
  })
  .sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime())
  .slice(0, 3);

const { positioning, solutions, caseStudies, metrics } = services;
const featuredCase = caseStudies.find(cs => cs.featured);
---

<Layout ogImage="/og/home.png">
  <!-- ============================================================
       HERO — Pure typography. WebGL canvas loads deferred (Step 7).
       ============================================================ -->
  <section class="relative border-b border-rule" id="hero">
    <canvas id="hero-canvas" class="absolute inset-0 w-full h-full" style="pointer-events: none; z-index: 0;" aria-hidden="true"></canvas>
    <div class="container relative z-10" style="padding-top: 128px; padding-bottom: 96px;">
      <p class="font-mono text-xs tracking-widest uppercase text-muted mb-6">Software Architect · AI Engineer · Amsterdam</p>
      <h1 class="font-display text-5xl md:text-6xl lg:text-7xl font-bold leading-[1.05] tracking-tight mb-8" style="max-width: 900px;">
        I build the <em class="text-accent italic">AI systems</em> that your business actually ships
      </h1>
      <p class="text-xl text-muted leading-relaxed mb-12" style="max-width: 540px;">
        From proof-of-concept to production. Agents, knowledge graphs, and intelligent platforms for enterprises that need them working, not demoed.
      </p>
      <div class="flex flex-col sm:flex-row gap-4">
        <a href="#contact" class="btn-primary">Get in touch</a>
        <a href="#solutions" class="btn-secondary">View solutions</a>
      </div>
    </div>
  </section>

  <!-- ============================================================
       STATS STRIP — Serif numbers, mono labels, 1px dividers
       ============================================================ -->
  <section class="border-b border-rule">
    <div class="container">
      <div class="grid grid-cols-2 md:grid-cols-4">
        {metrics.map((metric, i) => (
          <div class={`py-12 px-6 ${i < metrics.length - 1 ? 'md:border-r md:border-rule' : ''} ${i === 0 || i === 1 ? 'border-b md:border-b-0 border-rule' : ''}`}>
            <p class="font-display text-3xl md:text-4xl font-bold leading-none mb-2">{metric.value}</p>
            <p class="font-mono text-xs tracking-wider uppercase text-muted">{metric.label}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ============================================================
       SOLUTIONS (01) — Grid cells with 1px dividers
       ============================================================ -->
  <section id="solutions" class="border-b border-rule">
    <div class="container" style="padding-top: 96px; padding-bottom: 96px;">
      <div class="section-header">
        <div>
          <span class="section-number">01</span>
          <h2 class="section-title mt-2">What I build</h2>
        </div>
        <a href="/solutions" class="font-mono text-xs tracking-wider uppercase text-muted hover:text-ink transition-colors">View all →</a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 border border-rule">
        {solutions.map((solution, i) => (
          <a href={`/solutions/${solution.slug}`}
             class={`block p-8 hover:bg-muted-light transition-colors ${
               i % 3 !== 2 ? 'lg:border-r lg:border-rule' : ''
             } ${i % 2 !== 1 ? 'md:border-r md:border-rule lg:border-r-0' : 'md:border-r-0'} ${
               i < solutions.length - 3 ? 'lg:border-b lg:border-rule' : ''
             } ${i < solutions.length - 2 ? 'md:border-b md:border-rule lg:border-b-0' : 'md:border-b-0'} border-b border-rule last:border-b-0 md:last:border-b-0`}
          >
            <span class="font-mono text-xs text-muted tracking-wider">0{i + 1}</span>
            <h3 class="font-display text-xl font-bold mt-3 mb-2">{solution.shortTitle}</h3>
            <p class="text-sm text-muted leading-relaxed">{solution.subheadline.split(' — ')[0].substring(0, 120)}{solution.subheadline.length > 120 ? '...' : ''}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ============================================================
       FEATURED CASE STUDY (02) — Split layout
       ============================================================ -->
  {featuredCase && (
    <section class="border-b border-rule">
      <div class="container" style="padding-top: 96px; padding-bottom: 96px;">
        <div class="section-header">
          <div>
            <span class="section-number">02</span>
            <h2 class="section-title mt-2">Selected work</h2>
          </div>
          <a href="/case-studies" class="font-mono text-xs tracking-wider uppercase text-muted hover:text-ink transition-colors">All case studies →</a>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 border border-rule">
          <!-- Visual area (WebGL knowledge graph placeholder) -->
          <div class="bg-muted-light flex items-center justify-center min-h-[320px] md:min-h-[400px] border-b md:border-b-0 md:border-r border-rule">
            <span class="font-mono text-xs text-muted tracking-wider">Interactive visualization</span>
          </div>

          <!-- Content -->
          <div class="p-8 md:p-12 flex flex-col justify-center">
            <span class="font-mono text-xs tracking-widest uppercase text-accent mb-4">{featuredCase.domain}</span>
            <h3 class="font-display text-2xl md:text-3xl font-bold leading-tight mb-4">{featuredCase.title}</h3>
            <p class="text-muted leading-relaxed mb-6">{featuredCase.outcomes?.[0]}</p>
            <div class="flex flex-wrap gap-4 font-mono text-xs text-muted">
              <span>{featuredCase.technologies?.slice(0, 3).join(' · ')}</span>
              {featuredCase.duration && <span>{featuredCase.duration}</span>}
            </div>
            {featuredCase.hasFullPage && (
              <a href={`/case-studies/${featuredCase.slug}`} class="font-mono text-xs tracking-wider uppercase text-ink hover:text-accent transition-colors mt-6 inline-block">
                Read case study →
              </a>
            )}
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- ============================================================
       BLOG (03) — 3 cards with 1px dividers
       ============================================================ -->
  <section id="blog" class="border-b border-rule">
    <div class="container" style="padding-top: 96px; padding-bottom: 96px;">
      <div class="section-header">
        <div>
          <span class="section-number">03</span>
          <h2 class="section-title mt-2">Writing</h2>
        </div>
        <a href="/blog" class="font-mono text-xs tracking-wider uppercase text-muted hover:text-ink transition-colors">All posts →</a>
      </div>

      {posts.length > 0 ? (
        <div class="grid grid-cols-1 md:grid-cols-3 border border-rule">
          {posts.map((post, i) => (
            <a href={post.url}
               class={`block p-8 hover:bg-muted-light transition-colors ${i < posts.length - 1 ? 'border-b md:border-b-0 md:border-r border-rule' : ''}`}
            >
              {post.categories?.[0] && (
                <span class="font-mono text-xs tracking-widest uppercase text-accent">{post.categories[0]}</span>
              )}
              <h3 class="font-display text-lg font-bold mt-3 mb-3 leading-snug" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">{post.title}</h3>
              <time class="font-mono text-xs text-muted">
                {new Date(post.date).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}
              </time>
            </a>
          ))}
        </div>
      ) : (
        <div class="border border-rule p-12 text-center">
          <p class="text-muted">New writing coming soon.</p>
        </div>
      )}
    </div>
  </section>

  <!-- ============================================================
       LEAD CAPTURE — AI Readiness Checklist + email subscribe
       ============================================================ -->
  <section class="border-b border-rule">
    <div class="container" style="padding-top: 96px; padding-bottom: 96px;">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-12 md:gap-16 items-center">
        <div>
          <h2 class="font-display text-3xl font-bold mb-4">AI Readiness Checklist</h2>
          <p class="text-muted leading-relaxed">Score your organization across 8 dimensions — data, infrastructure, team skills, use case clarity, and more. Know where you stand before you invest.</p>
        </div>
        <div>
          <form id="subscribe-form" action="https://formspree.io/f/mdkdpbzj" method="POST" class="flex flex-col gap-4">
            <input type="text" name="_gotcha" style="display:none" tabindex="-1" autocomplete="off" />
            <input type="hidden" name="_subject" value="AI Readiness Checklist download" />
            <div class="flex">
              <input
                type="email"
                name="email"
                required
                placeholder="your@company.com"
                class="flex-1 px-5 py-3 border border-rule bg-transparent font-mono text-sm focus:border-ink outline-none text-ink placeholder:text-muted"
              />
              <button type="submit" id="subscribe-btn" class="btn-primary" style="border-left: none;">Get the checklist</button>
            </div>
            <div id="subscribe-status" class="hidden">
              <p class="font-mono text-xs text-ink mb-2">Your checklist is ready:</p>
              <a href="/ai-readiness-checklist.pdf" download class="font-mono text-xs text-accent hover:text-ink transition-colors">Download AI Readiness Checklist (PDF) →</a>
            </div>
          </form>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================
       CONTACT FORM — Formspree
       ============================================================ -->
  <section id="contact">
    <div class="container" style="padding-top: 96px; padding-bottom: 96px;">
      <div class="section-header">
        <div>
          <span class="section-number">04</span>
          <h2 class="section-title mt-2">Get in touch</h2>
        </div>
      </div>
      <div style="max-width: 800px;">
        <p class="text-muted leading-relaxed mb-10">Tell me about your challenge. No pitch, no pressure — just an honest conversation about whether I can help.</p>
        <ContactForm />
      </div>
    </div>
  </section>
</Layout>

<!-- WebGL particle field: deferred load via IntersectionObserver -->
<script>
  if ('IntersectionObserver' in window && 'WebGL2RenderingContext' in window) {
    const canvas = document.getElementById('hero-canvas');
    if (canvas) {
      const observer = new IntersectionObserver((entries) => {
        if (entries[0].isIntersecting) {
          import('../scripts/particles.js').then((m) => m.init(canvas));
          observer.disconnect();
        }
      }, { threshold: 0.1 });
      observer.observe(canvas);
    }
  }

  // Subscribe form handler
  const subForm = document.getElementById('subscribe-form');
  if (subForm) {
    subForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      const btn = document.getElementById('subscribe-btn') as HTMLButtonElement;
      const status = document.getElementById('subscribe-status')!;
      btn.disabled = true;
      btn.textContent = 'Sending...';
      try {
        const res = await fetch(subForm.getAttribute('action')!, {
          method: 'POST',
          body: new FormData(subForm as HTMLFormElement),
          headers: { 'Accept': 'application/json' }
        });
        if (res.ok) {
          status.classList.remove('hidden');
          btn.textContent = 'Sent!';
        } else {
          btn.textContent = 'Try again';
          btn.disabled = false;
        }
      } catch {
        btn.textContent = 'Try again';
        btn.disabled = false;
      }
    });
  }
</script>
