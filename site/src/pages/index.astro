---
import Layout from '../layouts/Layout.astro';
import ContactForm from '../components/ContactForm.astro';
import { services } from '../lib/data';
import { getPosts, postUrl, formatDate } from '../lib/posts';

const posts = (await getPosts()).slice(0, 3);
const { caseStudies, metrics } = services;
const featured = caseStudies.filter((cs) => cs.featured);
---

<Layout>
  <!-- ============================================================
       HERO — Pure typography. WebGL canvas loads deferred (Step 7).
       ============================================================ -->
  <section class="relative border-b border-rule" id="hero">
    <canvas id="hero-canvas" class="absolute inset-0 w-full h-full" style="pointer-events: none; z-index: 0;" aria-hidden="true"></canvas>
    <div class="container relative z-10" style="padding-top: 128px; padding-bottom: 96px;">
      <p class="font-mono text-xs tracking-widest uppercase text-muted mb-6">Software Architect · AI Engineer · Amsterdam</p>
      <h1 class="font-display text-5xl md:text-6xl lg:text-7xl font-bold leading-[1.05] tracking-tight mb-8" style="max-width: 900px;">
        I design and build <em class="text-accent italic">AI systems</em> and the platforms they run on
      </h1>
      <p class="text-xl text-muted leading-relaxed mb-12" style="max-width: 620px;">
        12+ years of production software, from payments and multi-brand e-commerce to knowledge graphs and multi-agent LLM pipelines. Currently at STX, writing software that speeds up the trading lifecycle and makes its agentic systems reliable, with complete data and provable behavior.
      </p>
      <div class="flex flex-col sm:flex-row gap-4">
        <a href="/cv" class="btn-primary">Read the CV</a>
        <a href="/case-studies" class="btn-secondary">Case studies</a>
      </div>
    </div>
  </section>

  <!-- ============================================================
       STATS STRIP — Serif numbers, mono labels, 1px dividers
       ============================================================ -->
  <section class="border-b border-rule">
    <div class="container">
      <div class="grid grid-cols-2 md:grid-cols-4">
        {metrics.map((metric, i) => (
          <div class={`py-12 px-6 ${i < metrics.length - 1 ? 'md:border-r md:border-rule' : ''} ${i === 0 || i === 1 ? 'border-b md:border-b-0 border-rule' : ''}`}>
            <p class="font-display text-3xl md:text-4xl font-bold leading-none mb-2">{metric.value}</p>
            <p class="font-mono text-xs tracking-wider uppercase text-muted">{metric.label}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ============================================================
       SELECTED WORK (01) — Featured case studies grid
       ============================================================ -->
  <section class="border-b border-rule">
    <div class="container" style="padding-top: 96px; padding-bottom: 96px;">
      <div class="section-header">
        <div>
          <span class="section-number">01</span>
          <h2 class="section-title mt-2">Selected work</h2>
        </div>
        <a href="/case-studies" class="font-mono text-xs tracking-wider uppercase text-muted hover:text-ink transition-colors">All case studies →</a>
      </div>

      <div class="flex flex-col gap-px bg-rule">
        {featured.map((cs) => (
          <a href={`/case-studies/${cs.slug}`} class="group grid grid-cols-1 md:grid-cols-2 bg-surface hover:bg-muted-light transition-colors">
            {/* Screenshot or styled placeholder */}
            <div class="bg-muted-light flex items-center justify-center min-h-[280px] md:min-h-[360px] overflow-hidden">
              {cs.screenshot ? (
                <img src={cs.screenshot} alt="" class="w-full h-full object-cover object-top" loading="lazy" />
              ) : (
                <div class="flex flex-col items-center justify-center gap-3 p-8 text-center">
                  <span class="font-mono text-xs text-muted tracking-wider uppercase">{cs.client}</span>
                  <span class="font-display text-lg text-muted/60">{cs.domain}</span>
                </div>
              )}
            </div>

            {/* Content */}
            <div class="p-8 md:p-12 flex flex-col justify-center">
              <span class="font-mono text-xs tracking-widest uppercase text-accent mb-3">{cs.client}</span>
              <h3 class="font-display text-xl md:text-2xl font-bold leading-tight mb-3 group-hover:text-accent transition-colors">{cs.title}</h3>
              <p class="text-muted leading-relaxed mb-5 text-sm">{cs.outcomes[0]}</p>
              <div class="flex flex-wrap gap-4 font-mono text-xs text-muted">
                <span>{cs.technologies.slice(0, 4).join(' · ')}</span>
                <span class="text-muted/60">{cs.duration}</span>
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ============================================================
       WRITING (02) — latest 3 posts
       ============================================================ -->
  <section id="blog" class="border-b border-rule">
    <div class="container" style="padding-top: 96px; padding-bottom: 96px;">
      <div class="section-header">
        <div>
          <span class="section-number">02</span>
          <h2 class="section-title mt-2">Writing</h2>
        </div>
        <a href="/blog" class="font-mono text-xs tracking-wider uppercase text-muted hover:text-ink transition-colors">All posts →</a>
      </div>

      {posts.length > 0 ? (
        <div class="grid grid-cols-1 md:grid-cols-3 border border-rule">
          {posts.map((post, i) => (
            <a href={postUrl(post)}
               class={`block p-8 hover:bg-muted-light transition-colors ${i < posts.length - 1 ? 'border-b md:border-b-0 md:border-r border-rule' : ''}`}
            >
              <span class="font-mono text-xs tracking-widest uppercase text-accent">{post.data.categories[0]}</span>
              <h3 class="font-display text-lg font-bold mt-3 mb-3 leading-snug" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">{post.data.title}</h3>
              <time datetime={post.data.pubDate.toISOString()} class="font-mono text-xs text-muted">
                {formatDate(post.data.pubDate)}
              </time>
            </a>
          ))}
        </div>
      ) : (
        <div class="border border-rule p-12 text-center">
          <p class="text-muted">New writing coming soon.</p>
        </div>
      )}
    </div>
  </section>

  <!-- ============================================================
       SIDE EXPERIMENT — text reflow with Pretext
       ============================================================ -->
  <section id="reflow-demo" class="border-b border-rule">
    <div class="container" style="padding-top: 64px; padding-bottom: 64px;">
      <div class="flex items-baseline justify-between mb-8">
        <h2 class="font-mono text-xs tracking-wider uppercase text-muted">Side experiment: DOM-free text reflow</h2>
        <a href="https://github.com/chenglou/pretext" target="_blank" rel="noopener" class="font-mono text-xs tracking-wider uppercase text-muted hover:text-ink transition-colors">Built on chenglou/pretext →</a>
      </div>
      <div data-reflow-container class="relative" style="min-height: 200px;">
        <div data-reflow-area class="relative w-full" style="min-height: 200px;">
          <div
            data-reflow-float
            class="absolute border border-rule bg-accent z-10"
            aria-hidden="true"
            style="width: 120px; height: 120px; cursor: grab; touch-action: none; opacity: 0.9;"
          ></div>
          <div
            data-reflow-text="Most AI projects stall in the gap between a working prototype and a system people rely on. Closing that gap is mostly engineering: knowledge graphs that turn scattered documents into something queryable, agent pipelines with clear responsibilities and fallbacks, evaluation that tells you whether a change made things better, and observability that shows what the system did and why. The demo is the easy part. The hard part is a system that still behaves at 2am on a Friday, six months after launch, when nobody remembers the details of how it was built."
            class="relative text-ink leading-relaxed"
            style="font-size: 16px;"
            aria-hidden="true"
          ><p class="reflow-fallback">Most AI projects stall in the gap between a working prototype and a system people rely on. Closing that gap is mostly engineering: knowledge graphs that turn scattered documents into something queryable, agent pipelines with clear responsibilities and fallbacks, evaluation that tells you whether a change made things better, and observability that shows what the system did and why. The demo is the easy part. The hard part is a system that still behaves at 2am on a Friday, six months after launch, when nobody remembers the details of how it was built.</p></div>
          <p class="sr-only">Most AI projects stall in the gap between a working prototype and a system people rely on. Closing that gap is mostly engineering: knowledge graphs that turn scattered documents into something queryable, agent pipelines with clear responsibilities and fallbacks, evaluation that tells you whether a change made things better, and observability that shows what the system did and why. The demo is the easy part. The hard part is a system that still behaves at 2am on a Friday, six months after launch, when nobody remembers the details of how it was built.</p>
        </div>
        <p class="font-mono text-xs text-muted mt-4 opacity-60">Drag the orange block: lines are laid out with arithmetic, not DOM measurement.</p>
      </div>
    </div>
  </section>

  <!-- ============================================================
       CONTACT FORM — Formspree
       ============================================================ -->
  <section id="contact">
    <div class="container" style="padding-top: 96px; padding-bottom: 96px;">
      <div class="section-header">
        <div>
          <span class="section-number">03</span>
          <h2 class="section-title mt-2">Get in touch</h2>
        </div>
      </div>
      <div style="max-width: 800px;">
        <p class="text-muted leading-relaxed mb-10">Email <a href="mailto:dvorson@gmail.com" class="text-ink underline hover:text-accent">dvorson@gmail.com</a>, find me on <a href="https://linkedin.com/in/dvorson" class="text-ink underline hover:text-accent" target="_blank" rel="noopener noreferrer">LinkedIn</a>, or use the form below.</p>
        <ContactForm />
      </div>
    </div>
  </section>
</Layout>

<!-- WebGL particle field: deferred load via IntersectionObserver -->
<script>
  if ('IntersectionObserver' in window && 'WebGL2RenderingContext' in window) {
    const canvas = document.getElementById('hero-canvas');
    if (canvas) {
      const observer = new IntersectionObserver((entries) => {
        if (entries[0].isIntersecting) {
          import('../scripts/particles.js').then((m) => m.init(canvas));
          observer.disconnect();
        }
      }, { threshold: 0.1 });
      observer.observe(canvas);
    }
  }

  // Editorial reflow demo: deferred load via IntersectionObserver
  const reflowContainer = document.querySelector('[data-reflow-container]');
  if (reflowContainer) {
    const reflowObserver = new IntersectionObserver((entries) => {
      if (entries[0].isIntersecting) {
        import('../scripts/editorial-reflow.js').then((m) => m.init(reflowContainer));
        reflowObserver.disconnect();
      }
    }, { threshold: 0.1 });
    reflowObserver.observe(reflowContainer);
  }
</script>
