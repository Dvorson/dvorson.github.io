---
import Layout from '../layouts/Layout.astro';

export async function getStaticPaths() {
  const postModules = import.meta.glob('../posts/*.md', { eager: true });

  return Object.entries(postModules).map(([path, post]) => {
    const slug = path.split('/').pop()?.replace('.md', '') || '';
    return {
      params: { slug },
      props: {
        post: {
          ...post.frontmatter,
          content: post.default
        }
      }
    };
  });
}

const { slug } = Astro.params;
const { post } = Astro.props;
const Content = post.content;

const ogMap: Record<string, string> = {
  'graphrag-implementation-guide-enterprise-knowledge-base': 'blog-graphrag-guide',
  'building-multi-agent-ai-systems-architecture-patterns': 'blog-multi-agent',
  'ai-consulting-rates-europe-2026-pricing-guide': 'blog-ai-rates',
  'rag-vs-graphrag-vs-fine-tuning-decision-framework': 'blog-rag-comparison',
  'enterprise-knowledge-base-neo4j-llm-agents': 'blog-neo4j-kb',
  'langflow-vs-langchain-vs-custom-ai-agent-architecture': 'blog-langflow-langchain',
  'headless-commerce-ai-search-personalization': 'blog-headless-ai',
  'real-cost-building-ai-agent-project-breakdowns': 'blog-ai-agent-cost',
  'top-ai-consulting-firms-netherlands-2026': 'blog-ai-firms-nl',
  'ai-for-ecommerce-high-roi-use-cases': 'blog-ai-ecommerce',
  'why-your-rag-implementation-not-working-fixes': 'blog-rag-fixes',
  'fractional-ai-architect-vs-consulting-agency': 'blog-fractional-vs-agency',
  'enterprise-software-architecture-patterns-consultant-guide': 'blog-sw-architecture',
  'react-nodejs-performance-optimization-consultant': 'blog-react-perf',
  'aws-azure-cloud-infrastructure-enterprise-guide': 'blog-cloud-infra',
  'technical-leadership-engineering-team-management': 'blog-tech-leadership',
  'ecommerce-platform-architecture-development-guide': 'blog-ecommerce-arch',
};
const ogImage = ogMap[slug as string] ? `/og/${ogMap[slug as string]}.png` : '/og/blog.png';
---

<Layout title={post.title} description={post.description} ogImage={ogImage}>
  <article class="container" style="padding-top: 64px; padding-bottom: 96px;">
    <!-- Article Header -->
    <header class="mb-12 border-b border-rule pb-8" style="max-width: 800px;">
      {post.categories?.[0] && (
        <a href={`/categories/${encodeURIComponent(post.categories[0])}/`} class="font-mono text-xs tracking-widest uppercase text-accent hover:text-ink transition-colors">
          {post.categories[0]}
        </a>
      )}

      <h1 class="font-display text-4xl md:text-5xl font-bold leading-tight mt-4 mb-6">{post.title}</h1>

      <div class="flex flex-wrap items-center gap-4 mb-6">
        <time class="font-mono text-xs text-muted">
          {new Date(post.date || post.pubDate).toLocaleDateString('en-US', {
            year: 'numeric',
            month: 'long',
            day: 'numeric'
          })}
        </time>

        {post.category && (
          <a href={`/categories/${encodeURIComponent(post.category)}/`} class="font-mono text-xs tracking-wider uppercase text-accent hover:text-ink transition-colors">
            {post.category}
          </a>
        )}
      </div>

      {post.description && (
        <p class="text-lg text-muted leading-relaxed mb-6">{post.description}</p>
      )}

      {post.tags && (
        <div class="flex flex-wrap gap-2">
          {post.tags.map((tag: string) => (
            <a
              href={`/tags/${encodeURIComponent(tag)}/`}
              class="font-mono text-xs border border-rule px-3 py-1 text-muted hover:text-ink hover:border-ink transition-colors"
            >
              {tag}
            </a>
          ))}
        </div>
      )}
    </header>

    <!-- Article Content -->
    <div style="max-width: 800px;">
      <div class="prose max-w-none">
        <Content />
      </div>
    </div>

    <!-- Article Footer -->
    <footer class="mt-16 pt-8 border-t border-rule" style="max-width: 800px;">
      <div class="flex items-center justify-between">
        <a href="/blog" class="font-mono text-xs tracking-wider uppercase text-muted hover:text-ink transition-colors">
          ← All posts
        </a>

        <div class="flex items-center gap-4">
          <span class="font-mono text-xs text-muted">Share:</span>
          <a href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(post.title)}&url=${encodeURIComponent(`https://dvorson.github.io/${slug}`)}`} target="_blank" rel="noopener noreferrer" class="text-muted hover:text-ink transition-colors" aria-label="Share on Twitter">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M23.953 4.57a10 10 0 01-2.825.775 4.958 4.958 0 002.163-2.723c-.951.555-2.005.959-3.127 1.184a4.92 4.92 0 00-8.384 4.482C7.69 8.095 4.067 6.13 1.64 3.162a4.822 4.822 0 00-.666 2.475c0 1.71.87 3.213 2.188 4.096a4.904 4.904 0 01-2.228-.616v.06a4.923 4.923 0 003.946 4.827 4.996 4.996 0 01-2.212.085 4.936 4.936 0 004.604 3.417 9.867 9.867 0 01-6.102 2.105c-.39 0-.779-.023-1.17-.067a13.995 13.995 0 007.557 2.209c9.053 0 13.998-7.496 13.998-13.985 0-.21 0-.42-.015-.63A9.935 9.935 0 0024 4.59z"/></svg>
          </a>
          <a href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(`https://dvorson.github.io/${slug}`)}`} target="_blank" rel="noopener noreferrer" class="text-muted hover:text-ink transition-colors" aria-label="Share on LinkedIn">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
          </a>
        </div>
      </div>
    </footer>
  </article>
</Layout>
