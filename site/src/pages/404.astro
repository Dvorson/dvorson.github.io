---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Page not found | Anton Dvorson" description="This page does not exist.">
  <section class="container" style="padding-top: 128px; padding-bottom: 128px;">
    <p class="font-mono text-xs tracking-widest uppercase text-muted mb-6">404</p>
    <h1 class="font-display text-4xl md:text-5xl font-bold mb-6">This page doesn't exist.</h1>
    <p class="text-muted leading-relaxed mb-10" style="max-width: 540px;">It may have moved when the site was reorganized.</p>
    <div class="flex flex-col sm:flex-row gap-4">
      <a href="/case-studies" class="btn-primary">Case studies</a>
      <a href="/blog" class="btn-secondary">Writing</a>
      <a href="/cv" class="btn-secondary">CV</a>
    </div>
  </section>
</Layout>
