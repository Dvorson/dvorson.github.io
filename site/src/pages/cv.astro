---
import Layout from '../layouts/Layout.astro';
import cv from '../data/cv.json';
---

<Layout title="CV — Anton Dvorson" description="Full CV for Anton Dvorson — Software Architect, GenAI Engineer, Full-Stack Developer." ogImage="/og/cv.png">
  <section class="container py-16">
    <div class="print:hidden mb-10 flex gap-4">
      <button class="btn-secondary" onclick="window.print()">Print / Save as PDF</button>
    </div>

    <!-- Header -->
    <header class="border-b border-rule pb-8 mb-12">
      <h1 class="font-display text-4xl font-bold mb-2">{cv.name}</h1>
      <div class="font-mono text-sm text-muted tracking-wide">{cv.role}</div>
      {cv.location && <div class="font-mono text-xs text-muted mt-1">{cv.location}</div>}
    </header>

    <!-- Summary -->
    <section class="mb-16">
      <div class="flex items-baseline gap-4 mb-6">
        <span class="section-number">01</span>
        <h2 class="section-title">Summary</h2>
      </div>
      <p class="text-ink leading-relaxed max-w-3xl">{cv.summary}</p>
    </section>

    <!-- Expertise -->
    <section class="mb-16">
      <div class="flex items-baseline gap-4 mb-6">
        <span class="section-number">02</span>
        <h2 class="section-title">Expertise</h2>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
        {cv.expertise.map((area: string) => (
          <div class="font-mono text-sm border border-rule px-4 py-3 text-ink">{area}</div>
        ))}
      </div>
    </section>

    <!-- Skills -->
    <section class="mb-16">
      <div class="flex items-baseline gap-4 mb-6">
        <span class="section-number">03</span>
        <h2 class="section-title">Core Technologies</h2>
      </div>
      <div class="flex flex-wrap gap-2">
        {cv.skills.map((skill: string) => (
          <span class="font-mono text-xs border border-rule px-3 py-1 text-muted">{skill}</span>
        ))}
      </div>
    </section>

    <!-- Experience -->
    <section class="mb-16">
      <div class="flex items-baseline gap-4 mb-8">
        <span class="section-number">04</span>
        <h2 class="section-title">Experience</h2>
      </div>
      {cv.experience.map((exp: any) => (
        <article class="mb-10 pb-10 border-b border-rule last:border-b-0">
          <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between mb-2">
            <h3 class="font-display text-xl font-bold">{exp.company}</h3>
            <span class="font-mono text-xs text-muted">{exp.start} – {exp.end} ({exp.duration})</span>
          </div>
          <div class="font-mono text-sm text-accent mb-1">{exp.title}</div>
          {exp.subtitle && <div class="text-sm text-muted mb-1">{exp.subtitle}</div>}
          {exp.location && <div class="font-mono text-xs text-muted mb-3">{exp.location}</div>}
          <p class="text-ink leading-relaxed mb-3">{exp.description}</p>
          {exp.highlights && (
            <div class="mt-3">
              <span class="font-mono text-xs text-muted uppercase tracking-wider">Key Highlights</span>
              <ul class="list-disc ml-5 mt-2 space-y-1">
                {exp.highlights.map((h: string) => <li class="text-ink leading-relaxed">{h}</li>)}
              </ul>
            </div>
          )}
          {exp.technologies && (
            <div class="mt-3">
              <span class="font-mono text-xs text-muted uppercase tracking-wider">Technologies</span>
              <p class="text-sm text-ink mt-1">{exp.technologies}</p>
            </div>
          )}
        </article>
      ))}
    </section>

    <!-- Education -->
    {cv.education && (
      <section class="mb-16">
        <div class="flex items-baseline gap-4 mb-6">
          <span class="section-number">05</span>
          <h2 class="section-title">Education</h2>
        </div>
        <div>
          <div class="font-bold">{cv.education.degree}, {cv.education.field}</div>
          <div class="font-mono text-sm text-muted">{cv.education.institution}</div>
        </div>
      </section>
    )}

    <!-- Languages -->
    {cv.languages && cv.languages.length > 0 && (
      <section class="mb-16">
        <div class="flex items-baseline gap-4 mb-6">
          <span class="section-number">06</span>
          <h2 class="section-title">Languages</h2>
        </div>
        <div class="flex gap-6">
          {cv.languages.map((l: any) => (
            <span class="text-ink">{l.language} <span class="font-mono text-xs text-muted">({l.level})</span></span>
          ))}
        </div>
      </section>
    )}
  </section>

  <style>
    @media print {
      nav, footer, .print\:hidden { display: none !important; }
      main { padding: 0 !important; }
    }
  </style>
</Layout>
