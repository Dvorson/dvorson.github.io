---
import Layout from '../layouts/Layout.astro';
import { cv, formatDuration } from '../lib/data';

const CONDENSE_BEFORE_YEAR = 2021;
---

<Layout title="CV | Anton Dvorson" description="Full CV for Anton Dvorson, software architect and AI engineer." ogImage="/og/cv.png">
  <section class="container py-16">
    <div class="print:hidden mb-10 flex gap-4">
      <a href="/cv.pdf" class="btn-primary" download="Anton-Dvorson-CV.pdf">Download PDF</a>
      <a href="mailto:dvorson@gmail.com" class="btn-secondary">Email</a>
    </div>

    <!-- Header -->
    <header class="border-b border-rule pb-8 mb-12">
      <h1 class="font-display text-4xl font-bold mb-2">{cv.name}</h1>
      <div class="font-mono text-sm text-muted tracking-wide">{cv.role}</div>
      <div class="font-mono text-xs text-muted mt-1">{cv.location}</div>
      <div class="font-mono text-xs text-muted mt-1">
        <a href={`mailto:${cv.contact.email}`} class="hover:text-ink">{cv.contact.email}</a> ·
        <a href={`https://${cv.contact.linkedin}`} class="hover:text-ink">{cv.contact.linkedin}</a> ·
        <a href="https://github.com/dvorson" class="hover:text-ink">github.com/dvorson</a> ·
        <a href={`https://${cv.contact.website}`} class="hover:text-ink">{cv.contact.website}</a>
      </div>
    </header>

    <!-- Summary -->
    <section class="mb-16">
      <div class="flex items-baseline gap-4 mb-6">
        <span class="section-number">01</span>
        <h2 class="section-title">Summary</h2>
      </div>
      <p class="text-ink leading-relaxed max-w-3xl">{cv.summary}</p>
    </section>

    <!-- Expertise (web only; the skills list below covers it in print) -->
    <section class="mb-16 print:hidden">
      <div class="flex items-baseline gap-4 mb-6">
        <span class="section-number">02</span>
        <h2 class="section-title">Expertise</h2>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
        {cv.expertise.map((area: string) => (
          <div class="font-mono text-sm border border-rule px-4 py-3 text-ink">{area}</div>
        ))}
      </div>
    </section>

    <!-- Skills -->
    <section class="mb-16">
      <div class="flex items-baseline gap-4 mb-6">
        <span class="section-number">03</span>
        <h2 class="section-title">Core Technologies</h2>
      </div>
      <div class="skill-tags flex flex-wrap gap-2">
        {cv.skills.map((skill: string) => (
          <span class="font-mono text-xs border border-rule px-3 py-1 text-muted">{skill}</span>
        ))}
      </div>
    </section>

    <!-- Projects -->
    <section class="mb-16">
      <div class="flex items-baseline gap-4 mb-8">
        <span class="section-number">04</span>
        <h2 class="section-title">Projects</h2>
      </div>
      {cv.projects.map((project) => (
        <article class="mb-10">
          <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between mb-2">
            <h3 class="font-display text-xl font-bold">
              {project.link ? <a href={project.link} class="hover:text-accent">{project.name}</a> : project.name}
            </h3>
            <span class="font-mono text-xs text-muted">{project.start} – {project.end}</span>
          </div>
          <div class="font-mono text-sm text-accent mb-3">{project.role}</div>
          <p class="text-ink leading-relaxed mb-3">{project.description}</p>
          <ul class="list-disc ml-5 mt-2 space-y-1">
            {project.highlights.map((h) => <li class="text-ink leading-relaxed">{h}</li>)}
          </ul>
          <p class="text-sm text-muted mt-3">{project.technologies}</p>
        </article>
      ))}
    </section>

    <!-- Experience -->
    <section class="mb-16">
      <div class="flex items-baseline gap-4 mb-8">
        <span class="section-number">05</span>
        <h2 class="section-title">Experience</h2>
      </div>
      {cv.experience.map((exp) => {
        // Roles that started before 2021 print as a header line plus one highlight.
        const condensed = Number(exp.start.slice(-4)) < CONDENSE_BEFORE_YEAR;
        const printHidden = condensed ? 'print:hidden' : '';
        return (
        <article class="mb-10 pb-10 border-b border-rule last:border-b-0">
          <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between mb-2">
            <h3 class="font-display text-xl font-bold">{exp.company}</h3>
            <span class="font-mono text-xs text-muted">{exp.start} – {exp.end} ({formatDuration(exp.start, exp.end)})</span>
          </div>
          <div class="font-mono text-sm text-accent mb-1">{exp.title}</div>
          {exp.subtitle && <div class="text-sm text-muted mb-1">{exp.subtitle}</div>}
          {exp.location && <div class={`font-mono text-xs text-muted mb-3 ${printHidden}`}>{exp.location}</div>}
          <p class={`exp-description text-ink leading-relaxed mb-3 ${printHidden}`}>{exp.description}</p>
          {exp.highlights && (
            <div class="mt-3">
              <span class={`font-mono text-xs text-muted uppercase tracking-wider ${printHidden}`}>Key Highlights</span>
              <ul class="list-disc ml-5 mt-2 space-y-1">
                {exp.highlights.map((h: string, i: number) => <li class={`text-ink leading-relaxed ${i > 0 ? printHidden : ''}`}>{h}</li>)}
              </ul>
            </div>
          )}
          {exp.technologies && (
            <div class={`mt-3 ${printHidden}`}>
              <span class="font-mono text-xs text-muted uppercase tracking-wider">Technologies</span>
              <p class="text-sm text-ink mt-1">{exp.technologies}</p>
            </div>
          )}
        </article>
        );
      })}
    </section>

    <!-- Education -->
    {cv.education && (
      <section class="mb-16 cv-closing">
        <div class="flex items-baseline gap-4 mb-6">
          <span class="section-number">06</span>
          <h2 class="section-title">Education</h2>
        </div>
        <div>
          <div class="font-bold">{cv.education.degree}, {cv.education.field}</div>
          <div class="font-mono text-sm text-muted">{cv.education.institution}</div>
        </div>
      </section>
    )}

    <!-- Languages -->
    {cv.languages && cv.languages.length > 0 && (
      <section class="mb-16 cv-closing">
        <div class="flex items-baseline gap-4 mb-6">
          <span class="section-number">07</span>
          <h2 class="section-title">Languages</h2>
        </div>
        <div class="flex gap-6">
          {cv.languages.map((l) => (
            <span class="text-ink">{l.language} <span class="font-mono text-xs text-muted">({l.level})</span></span>
          ))}
        </div>
      </section>
    )}
  </section>

  <style>
    @media print {
      :global(body) { background: #fff !important; font-size: 9.5pt; }
      :global(main) > section { padding: 0 !important; }
      section section { margin-bottom: 12pt !important; }
      header { padding-bottom: 8pt !important; margin-bottom: 12pt !important; }
      h1 { font-size: 22pt !important; margin-bottom: 2pt !important; }
      .section-title { font-size: 13pt !important; }
      .section-number { display: none; }
      section section > div:first-child { margin-bottom: 6pt !important; }
      article { margin-bottom: 8pt !important; padding-bottom: 8pt !important; }
      article h3 { font-size: 12pt !important; }
      article p, article li { line-height: 1.35 !important; }
      article ul { margin-top: 2pt !important; }
      article li + li { margin-top: 1pt !important; }
      article > div.mt-3 { margin-top: 4pt !important; }
      /* Highlights carry the substance; the description and repeated labels do not. */
      article > p.exp-description, article span.uppercase, article div.font-mono.text-xs.mb-3 { display: none; }
      article h3, article > div:first-child { break-after: avoid; }
      li { break-inside: avoid; }
      /* Education and languages share one row so they do not spill onto a new page. */
      .cv-closing { display: inline-block; width: 49%; vertical-align: top; margin-bottom: 0 !important; }
      article:last-child { margin-bottom: 0 !important; padding-bottom: 0 !important; }
      .skill-tags { gap: 3pt !important; }
      .skill-tags span { padding: 0 4pt !important; font-size: 8pt !important; }
    }
  </style>
</Layout>
