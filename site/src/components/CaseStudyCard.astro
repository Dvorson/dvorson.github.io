---
export interface Props {
  caseStudy: {
    slug: string;
    title: string;
    domain: string;
    client: string;
    outcomes: string[];
    technologies: string[];
    icon: string;
    iconPath: string;
    hasFullPage: boolean;
  };
}

const { caseStudy } = Astro.props;
const keyOutcome = caseStudy.outcomes[0] || '';
---

<div class="border border-rule p-8 h-full flex flex-col hover:bg-muted-light transition-colors">
  <span class="font-mono text-xs tracking-widest uppercase text-accent mb-3">
    {caseStudy.domain}
  </span>

  <h3 class="font-display text-lg font-bold mb-1">
    {caseStudy.title}
  </h3>

  <p class="text-sm text-muted mb-4">
    {caseStudy.client}
  </p>

  {keyOutcome && (
    <div class="border-l-2 border-accent pl-4 mb-4">
      <p class="text-sm text-ink">{keyOutcome}</p>
    </div>
  )}

  <div class="flex flex-wrap gap-2 mb-6 flex-grow">
    {caseStudy.technologies.map((tech) => (
      <span class="font-mono text-xs border border-rule px-2 py-1 text-muted">
        {tech}
      </span>
    ))}
  </div>

  {caseStudy.hasFullPage && (
    <a
      href={`/case-studies/${caseStudy.slug}`}
      class="font-mono text-xs tracking-wider uppercase text-ink hover:text-accent transition-colors mt-auto"
    >
      Read case study →
    </a>
  )}
</div>
