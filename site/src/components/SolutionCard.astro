---
export interface Props {
  solution: {
    slug: string;
    shortTitle: string;
    headline: string;
    subheadline: string;
    icon: string;
    iconPath: string;
  };
}

const { solution } = Astro.props;
---

<a href={`/solutions/${solution.slug}`} class="group block h-full">
  <div class="border border-rule p-8 hover:bg-muted-light transition-colors h-full flex flex-col">
    <h3 class="font-display text-xl font-bold mb-2 group-hover:text-accent transition-colors">
      {solution.headline}
    </h3>
    <p class="text-sm text-muted leading-relaxed mb-6 flex-grow">
      {solution.subheadline}
    </p>
    <span class="font-mono text-xs tracking-wider uppercase text-muted group-hover:text-accent transition-colors">
      Learn more →
    </span>
  </div>
</a>
