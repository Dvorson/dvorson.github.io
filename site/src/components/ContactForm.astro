---
export interface Props {
  formspreeId?: string;
}

const { formspreeId = 'mdkdpbzj' } = Astro.props;
---

<form
  id="contact-form"
  action={`https://formspree.io/f/${formspreeId}`}
  method="POST"
  class="grid grid-cols-1 md:grid-cols-2 gap-6"
>
  <!-- Honeypot spam protection -->
  <input type="text" name="_gotcha" style="display:none" tabindex="-1" autocomplete="off" />
  <input type="hidden" name="_subject" value="New contact from dvorson.github.io" />

  <div>
    <label for="contact-name" class="block font-mono text-xs tracking-wider uppercase text-muted mb-2">Name</label>
    <input
      id="contact-name"
      type="text"
      name="name"
      required
      placeholder="Your name"
      class="w-full px-4 py-3 border border-rule bg-transparent font-body text-sm text-ink placeholder:text-muted focus:border-ink outline-none transition-colors"
    />
  </div>

  <div>
    <label for="contact-email" class="block font-mono text-xs tracking-wider uppercase text-muted mb-2">Email</label>
    <input
      id="contact-email"
      type="email"
      name="email"
      required
      placeholder="your@company.com"
      class="w-full px-4 py-3 border border-rule bg-transparent font-mono text-sm text-ink placeholder:text-muted focus:border-ink outline-none transition-colors"
    />
  </div>

  <div class="md:col-span-2">
    <label for="contact-message" class="block font-mono text-xs tracking-wider uppercase text-muted mb-2">Message</label>
    <textarea
      id="contact-message"
      name="message"
      required
      rows="5"
      placeholder="Tell me about your challenge..."
      class="w-full px-4 py-3 border border-rule bg-transparent font-body text-sm text-ink placeholder:text-muted focus:border-ink outline-none transition-colors resize-none"
    ></textarea>
  </div>

  <div class="md:col-span-2 flex items-center gap-6">
    <button type="submit" id="contact-submit" class="btn-primary">Send message</button>
    <span id="contact-status" class="font-mono text-xs text-muted hidden"></span>
  </div>
</form>

<script is:inline>
  document.getElementById('contact-form').addEventListener('submit', async function(e) {
    e.preventDefault();
    var form = this;
    var btn = document.getElementById('contact-submit');
    var status = document.getElementById('contact-status');

    btn.disabled = true;
    btn.textContent = 'Sending...';
    status.classList.add('hidden');

    try {
      var res = await fetch(form.action, {
        method: 'POST',
        body: new FormData(form),
        headers: { 'Accept': 'application/json' }
      });

      if (res.ok) {
        form.reset();
        status.textContent = 'Message sent. I\'ll get back to you shortly.';
        status.classList.remove('hidden');
        status.style.color = '#0a0a0a';
      } else {
        status.textContent = 'Something went wrong. Try emailing dvorson@gmail.com directly.';
        status.classList.remove('hidden');
        status.style.color = '#ff5722';
      }
    } catch (err) {
      status.textContent = 'Network error. Try emailing dvorson@gmail.com directly.';
      status.classList.remove('hidden');
      status.style.color = '#ff5722';
    }

    btn.disabled = false;
    btn.textContent = 'Send message';
  });
</script>
