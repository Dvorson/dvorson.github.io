---
export interface Props {
  headline: string;
  description: string;
  ctaText?: string;
  ctaLink?: string;
}

const {
  headline,
  description,
  ctaText = 'Book a Call',
  ctaLink = 'https://calendly.com/dvorson',
} = Astro.props;
---

<section class="border-t border-b border-rule py-16 my-16">
  <div class="max-w-2xl mx-auto text-center">
    <h2 class="font-display text-3xl font-bold mb-4">
      {headline}
    </h2>
    <p class="text-muted leading-relaxed mb-8">
      {description}
    </p>
    <a
      href={ctaLink}
      target="_blank"
      rel="noopener noreferrer"
      class="btn-primary"
    >
      {ctaText}
    </a>
  </div>
</section>
